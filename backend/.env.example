# Copy this file to backend/.env and fill in real values. backend/.env is
# git-ignored on purpose — never commit real secrets.

# MongoDB connection string. Options:
#   - MongoDB Atlas (free tier): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
#   - Local MongoDB: mongodb://localhost:27017
MONGO_URL="mongodb+srv://user:password@cluster.mongodb.net"

# Database name to use on that MongoDB connection.
DB_NAME="portfolio"

# Comma-separated allowlist of emails allowed into /admin/research.
ADMIN_EMAILS="soumyajits2000@gmail.com,soumyajitsomu@gmail.com"

# Google OAuth Client ID (Web application) — see README "Deploying it yourself".
# Same value goes into frontend/.env as REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# Comma-separated list of frontend origins allowed to call this API with
# credentials, e.g. "https://soumyajit.in,https://www.soumyajit.in".
# Leave empty during local development to allow any origin.
CORS_ORIGINS=""

# "production" (default) or "development". development relaxes the session
# cookie so admin login also works over plain http://localhost.
ENV="production"
