# Copy this file to frontend/.env and fill in real values. frontend/.env is
# git-ignored on purpose.

# Base URL of the deployed backend (no trailing slash, no /api suffix).
REACT_APP_BACKEND_URL="https://your-backend-host.example.com"

# Same Google OAuth Client ID as backend/.env's GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
